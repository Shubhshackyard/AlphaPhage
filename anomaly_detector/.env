# Delta Lake paths
DELTA_BRONZE_PATH=/data/delta/bronze/narratives
DELTA_SILVER_PATH=/data/delta/silver/narratives
DELTA_GOLD_PATH=/data/delta/gold/alerts

# Anomaly detection parameters
ANOMALY_LOOKBACK_DAYS=30
ZSCORE_THRESHOLD=2.5
MIN_VOLUME=5

# Notification settings
ENABLE_WEBHOOK=false
WEBHOOK_URL=https://hooks.slack.com/services/your/webhook/url

ENABLE_EMAIL=false
EMAIL_RECIPIENTS=your.email@example.com
EMAIL_SENDER=alphaphage@example.com

# SMTP settings (for Gmail example)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your.email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_USE_TLS=true

# API settings
API_HOST=api
API_PORT=8000

# Scheduling
DETECTION_INTERVAL_MINUTES=60
NOTIFICATION_INTERVAL_MINUTES=15